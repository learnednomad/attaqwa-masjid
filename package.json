{
  "name": "@attaqwa/root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "web:dev": "turbo dev --filter=@attaqwa/web",
    "api:dev": "turbo dev --filter=@attaqwa/api",
    "monitor:prayer-times": "cd packages/api && npx tsx src/scripts/prayer-times-monitor.ts",
    "monitor:prayer-times:test": "cd packages/api && npx tsx src/scripts/prayer-times-monitor.ts test",
    "monitor:prayer-times:status": "cd packages/api && npx tsx src/scripts/prayer-times-monitor.ts status"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^14.0.0"
  }
}
