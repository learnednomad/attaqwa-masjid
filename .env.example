# Docker Compose Environment Variables
# Copy this file to .env and update the values for your environment

# Environment
NODE_ENV=development

# Database Configuration
POSTGRES_DB=attaqwa_db
POSTGRES_USER=attaqwa_user
POSTGRES_PASSWORD=attaqwa_secure_2024!
DATABASE_URL=postgresql://attaqwa_user:attaqwa_secure_2024%21@postgres:5432/attaqwa_db

# Redis Configuration
REDIS_PASSWORD=redis_secure_password_2024

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Application URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Islamic APIs
NEXT_PUBLIC_ALADHAN_API_URL=https://api.aladhan.com/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Analytics (Production)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_MOBILE_APP=false
NEXT_PUBLIC_ENABLE_EDUCATION_MODULE=true
NEXT_PUBLIC_ENABLE_DONATIONS=false

# Default Location
NEXT_PUBLIC_DEFAULT_CITY=New York
NEXT_PUBLIC_DEFAULT_COUNTRY=US

# Email Configuration (Production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Monitoring (Production)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
GRAFANA_ADMIN_PASSWORD=admin_change_this_password

# SSL Configuration (Production)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem