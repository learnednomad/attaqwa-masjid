# Staging Environment Configuration
# This file contains staging-specific environment variables
# Staging environment mirrors production but with test data

# Environment
NODE_ENV=staging

# Database Configuration
POSTGRES_DB=attaqwa_staging
POSTGRES_USER=attaqwa_staging_user
POSTGRES_PASSWORD=staging_secure_password_123!
DATABASE_URL=postgresql://attaqwa_staging_user:staging_secure_password_123%21@postgres:5432/attaqwa_staging

# Redis Configuration
REDIS_PASSWORD=staging_redis_password_456!
REDIS_URL=redis://:staging_redis_password_456%21@redis:6379

# JWT Configuration
JWT_SECRET=staging-jwt-secret-key-for-testing-32-chars-min

# Application URLs - Staging subdomain
FRONTEND_URL=https://staging.attaqwa-masjid.com
NEXT_PUBLIC_APP_URL=https://staging.attaqwa-masjid.com
NEXT_PUBLIC_API_URL=https://staging-api.attaqwa-masjid.com

# Islamic APIs
NEXT_PUBLIC_ALADHAN_API_URL=https://api.aladhan.com/v1

# Rate Limiting (More lenient for testing)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Logging (More verbose for debugging)
LOG_LEVEL=debug

# Analytics and Monitoring (Test keys)
NEXT_PUBLIC_GA_ID=G-STAGING123
NEXT_PUBLIC_POSTHOG_KEY=phc_staging_key_for_testing
SENTRY_DSN=https://staging@sentry.io/staging
NEW_RELIC_LICENSE_KEY=NRAK-STAGING-KEY

# Feature Flags (All enabled for testing)
NEXT_PUBLIC_ENABLE_MOBILE_APP=true
NEXT_PUBLIC_ENABLE_EDUCATION_MODULE=true
NEXT_PUBLIC_ENABLE_DONATIONS=true

# Default Location
NEXT_PUBLIC_DEFAULT_CITY=New York
NEXT_PUBLIC_DEFAULT_COUNTRY=US

# Email Configuration (Test SMTP - Mailhog or similar)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=test@staging.attaqwa-masjid.com
EMAIL_FROM_NAME=Staging Masjid At-Taqwa

# SSL Configuration (Self-signed for staging)
SSL_CERT_PATH=/etc/nginx/ssl/staging-cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/staging-key.pem

# Security (Less strict for testing)
BCRYPT_ROUNDS=8
SESSION_SECRET=staging-session-secret-789
CORS_ORIGIN=https://staging.attaqwa-masjid.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Islamic Content APIs (Free tier for staging)
ISLAMIC_FINDER_API_KEY=staging_test_key
QURAN_API_KEY=staging_test_key
HADITH_API_KEY=staging_test_key

# Payment Processing (Test mode)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Backup Configuration (Less frequent)
BACKUP_SCHEDULE=0 4 * * 1
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=attaqwa-masjid-staging-backups

# Monitoring
GRAFANA_ADMIN_PASSWORD=staging_admin_password
PROMETHEUS_RETENTION=7d
ALERT_EMAIL=staging-alerts@attaqwa-masjid.com

# CDN Configuration
CDN_URL=https://staging-cdn.attaqwa-masjid.com
STATIC_ASSETS_URL=https://staging-static.attaqwa-masjid.com

# Performance Monitoring
PERFORMANCE_MONITORING=true
APM_SERVER_URL=https://staging-apm.attaqwa-masjid.com

# Test Data Configuration
SEED_TEST_DATA=true
TEST_ADMIN_EMAIL=admin@staging.attaqwa-masjid.com
TEST_ADMIN_PASSWORD=StagingAdmin123!

# Islamic Calendar Configuration
HIJRI_ADJUSTMENT=0
CALCULATION_METHOD=ISNA
FIQH_METHOD=Standard

# Cache Configuration (Shorter TTL for testing)
CACHE_TTL_PRAYER_TIMES=1800
CACHE_TTL_ANNOUNCEMENTS=60
CACHE_TTL_EVENTS=300
CACHE_TTL_ISLAMIC_CALENDAR=43200