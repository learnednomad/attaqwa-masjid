# Production Environment Configuration
# This file contains production-specific environment variables
# Make sure to update these values for your production deployment

# Environment
NODE_ENV=production

# Database Configuration
POSTGRES_DB=attaqwa_production
POSTGRES_USER=attaqwa_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_SECURE_PASSWORD_123!
DATABASE_URL=postgresql://attaqwa_prod_user:CHANGE_THIS_IN_PRODUCTION_SECURE_PASSWORD_123%21@postgres:5432/attaqwa_production

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION_456!
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION_456%21@redis:6379

# JWT Configuration - CRITICAL: Change this to a secure 32+ character secret
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_32_PLUS_CHARACTER_JWT_SECRET_IN_PRODUCTION

# Application URLs - Update with your production domain
FRONTEND_URL=https://attaqwa-masjid.com
NEXT_PUBLIC_APP_URL=https://attaqwa-masjid.com
NEXT_PUBLIC_API_URL=https://api.attaqwa-masjid.com

# Islamic APIs
NEXT_PUBLIC_ALADHAN_API_URL=https://api.aladhan.com/v1

# Rate Limiting (Stricter for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# Logging
LOG_LEVEL=info

# Analytics and Monitoring
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
NEW_RELIC_LICENSE_KEY=NRAK-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_MOBILE_APP=true
NEXT_PUBLIC_ENABLE_EDUCATION_MODULE=true
NEXT_PUBLIC_ENABLE_DONATIONS=true

# Default Location for Prayer Times
NEXT_PUBLIC_DEFAULT_CITY=Mecca
NEXT_PUBLIC_DEFAULT_COUNTRY=SA

# Email Configuration (Production SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@attaqwa-masjid.com
SMTP_PASS=CHANGE_THIS_EMAIL_PASSWORD
EMAIL_FROM=noreply@attaqwa-masjid.com
EMAIL_FROM_NAME=Masjid At-Taqwa

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
SSL_CHAIN_PATH=/etc/nginx/ssl/chain.pem

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_IN_PRODUCTION_789
CORS_ORIGIN=https://attaqwa-masjid.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Islamic Content APIs (Premium for production)
ISLAMIC_FINDER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
QURAN_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
HADITH_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX

# Payment Processing (for donations)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=attaqwa-masjid-backups
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_REGION=us-east-1

# Monitoring and Alerting
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD_IN_PRODUCTION
PROMETHEUS_RETENTION=30d
ALERT_EMAIL=admin@attaqwa-masjid.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX

# CDN Configuration
CDN_URL=https://cdn.attaqwa-masjid.com
STATIC_ASSETS_URL=https://static.attaqwa-masjid.com

# Search Configuration
ELASTICSEARCH_URL=https://elasticsearch.attaqwa-masjid.com:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_THIS_ELASTICSEARCH_PASSWORD

# Cache Configuration
CACHE_TTL_PRAYER_TIMES=3600
CACHE_TTL_ANNOUNCEMENTS=300
CACHE_TTL_EVENTS=600
CACHE_TTL_ISLAMIC_CALENDAR=86400

# Performance Monitoring
PERFORMANCE_MONITORING=true
APM_SERVER_URL=https://apm.attaqwa-masjid.com
APM_SECRET_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX

# Legal and Compliance
PRIVACY_POLICY_URL=https://attaqwa-masjid.com/privacy
TERMS_OF_SERVICE_URL=https://attaqwa-masjid.com/terms
GDPR_COMPLIANCE=true

# Internationalization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar,ur,id,tr,fr

# Islamic Calendar Configuration
HIJRI_ADJUSTMENT=0
CALCULATION_METHOD=MWL
FIQH_METHOD=Standard

# Community Features
ENABLE_FORUMS=true
ENABLE_EVENTS_RSVP=true
ENABLE_VOLUNTEER_MANAGEMENT=true
ENABLE_DONATION_TRACKING=true

# Admin Configuration
ADMIN_EMAIL=admin@attaqwa-masjid.com
SUPER_ADMIN_EMAIL=superadmin@attaqwa-masjid.com
SUPPORT_EMAIL=support@attaqwa-masjid.com

# Deployment Configuration
DEPLOYMENT_ENVIRONMENT=production
BUILD_NUMBER=${GITHUB_RUN_NUMBER}
GIT_COMMIT=${GITHUB_SHA}
DEPLOY_TIMESTAMP=${GITHUB_RUN_DATE}

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Rate Limiting per Service
API_RATE_LIMIT=100
AUTH_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=5
SEARCH_RATE_LIMIT=50

# Content Security Policy
CSP_REPORT_URI=https://attaqwa-masjid.report-uri.com/r/d/csp/enforce